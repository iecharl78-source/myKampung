# Salin ke .env pada akar projek. Gantikan contoh ini dengan domain dan e-mel anda.
DOMAIN=kampung.example.com
ACME_EMAIL=pentadbir@example.com

# 64 aksara hex rawak; simpan berasingan daripada sandaran pangkalan data.
MFA_ENCRYPTION_KEY=

# Sela jangkaan/jadual sandaran dalam jam (1 hingga 168).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
